{
  // Cloudflare Worker for vectisadvisory.co.nz: static site plus the contact form.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vectis-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Build the Astro site before every deploy (Cloudflare's build command is empty).
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Not secret: where enquiries go and who they come from. Secrets (API keys) are set in Cloudflare.
  "vars": {
    "CONTACT_TO": "mark@vectisadvisory.co.nz",
    "CONTACT_FROM": "Vectis website <website@vectisadvisory.co.nz>"
  },
  // Keep any values added in the dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true }
}
