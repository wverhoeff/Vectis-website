---
import { site } from '../config';
import '../styles/site.css';
interface Props { title?: string; noindex?: boolean; }
const { title = 'Vectis — The capability to shape what comes next.', noindex = false } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071b2c" />
    <meta name="description" content={site.description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vectis" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={site.url ? `${site.url}/assets/vectis-wordmark.png` : '/assets/vectis-wordmark.png'} />
    <meta property="og:image:alt" content="Vectis" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
