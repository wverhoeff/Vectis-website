---
import { buildFrame, makeView } from '../scripts/frame-geometry.js';
// A still drawing of the frame for visitors without JavaScript; the canvas replaces it.
const { nodes, members } = buildFrame();
const view = makeView(0.62, 0.42, 1, 0, 0);
const p = nodes.map(view);
const xs = p.map(q => q[0]), ys = p.map(q => q[1]);
const pad = 24;
const box = [Math.min(...xs) - pad, Math.min(...ys) - pad, Math.max(...xs) - Math.min(...xs) + pad * 2, Math.max(...ys) - Math.min(...ys) + pad * 2].map(n => n.toFixed(1)).join(' ');
const line = (m: { a: number; b: number }) => `M${p[m.a][0].toFixed(1)},${p[m.a][1].toFixed(1)}L${p[m.b][0].toFixed(1)},${p[m.b][1].toFixed(1)}`;
const groups = ['column', 'beam', 'brace'].map(type => ({ type, d: members.filter(m => m.type === type).map(line).join('') }));
---
<figure class="hero-visual" aria-labelledby="frame-caption">
  <svg class="frame-still" viewBox={box} aria-hidden="true">
    {groups.map(g => <path class={`still-${g.type}`} d={g.d}/>)}
  </svg>
  <canvas class="frame-canvas" aria-hidden="true"></canvas>
  <figcaption id="frame-caption" class="visually-hidden">An illustrative structural frame builds itself storey by storey. Points of cyan light travel through its members and a cyan plane rises through the levels.</figcaption>
  <button class="motion-toggle" type="button" hidden aria-pressed="false">Pause motion</button>
</figure>
<script src="../scripts/frame.js"></script>
