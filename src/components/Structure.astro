---
type Point = [number, number, number];
type Shape = { points: Point[]; closed?: boolean; slab?: number };
const yaw = 0.64;
const project = ([x, y, z]: Point) => [405 + (x * Math.cos(yaw) + z * Math.sin(yaw)) * 1.12, 520 - y * 1.04 + (z * Math.cos(yaw) - x * Math.sin(yaw)) * .42];
const path = (s: Shape) => 'M' + s.points.map(p => project(p).map(n => n.toFixed(2)).join(',')).join('L') + (s.closed ? 'Z' : '');
const points = (s: Shape) => s.points.map(p => p.join(',')).join(';');
const ground: Shape[] = [], floors: Shape[] = [], frame: Shape[] = [], bracing: Shape[] = [];
const levels = [0,60,120,180,240,300,360], xs = [-132,-44,44,132], zs = [-100,0,100];
// The three capability levels: foundation, middle, top.
const slabs: Record<number, number> = { 0: 0, 180: 1, 360: 2 };
for(let x=-300;x<=300;x+=60) ground.push({points:[[x,-4,-240],[x,-4,240]]});
for(let z=-240;z<=240;z+=60) ground.push({points:[[-300,-4,z],[300,-4,z]]});
for(const y of levels) {
  floors.push({points:[[-132,y,-100],[132,y,-100],[132,y,100],[-132,y,100]],closed:true,slab:slabs[y]});
  for(const x of xs.slice(1,-1)) frame.push({points:[[x,y,-100],[x,y,100]]});
  frame.push({points:[[-132,y,0],[132,y,0]]});
}
for(const x of xs) for(const z of zs) frame.push({points:[[x,0,z],[x,360,z]]});
for(const z of [-100,100]) for(const y of levels.slice(0,-1)) for(let i=0;i<3;i++) bracing.push({points:[[xs[i],y,z],[xs[i+1],y+60,z]]});
for(const y of [0,120,240]) bracing.push({points:[[-132,y,-100],[-132,y+120,100]]});
const plane: Shape = {points:[[-150,0,-118],[150,0,-118],[150,0,118],[-150,0,118]],closed:true};
const nodes: Point[] = xs.flatMap(x => [0,180,360].map(y => [x,y,100] as Point));
const groups = [{id:'ground',shapes:ground},{id:'floors',shapes:floors},{id:'frame',shapes:frame},{id:'bracing',shapes:bracing}];
---
<figure class="structural-visual">
  <svg id="structure" viewBox="40 60 730 520" role="img" aria-labelledby="structure-title structure-description">
    <title id="structure-title">A structural frame</title>
    <desc id="structure-description">An illustrative structural frame. A cyan plane rises through its levels, marking the foundation, the middle and the top as each capability is described.</desc>
    {groups.map(g => <g id={g.id}>{g.shapes.map(s => <path pathLength="1" data-points={points(s)} data-closed={String(!!s.closed)} data-slab={s.slab} d={path(s)}/>)}</g>)}
    <g id="scan"><path pathLength="1" data-points={points(plane)} data-closed="true" data-plane="true" d={path(plane)}/></g>
    <text id="level-label" x="0" y="0" aria-hidden="true"></text>
    <g id="nodes">{nodes.map(p => <circle data-point={p.join(',')} cx={project(p)[0]} cy={project(p)[1]} r="2.4"/>)}</g>
  </svg>
  <figcaption class="scene-caption"><button id="motion-toggle" type="button" hidden>Pause motion</button></figcaption>
</figure>
<script src="../scripts/motion.js"></script>
