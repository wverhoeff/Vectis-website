---
import Page from '../layouts/Page.astro';
import Structure from '../components/Structure.astro';
import { site } from '../config';
// Read top to bottom, foundation first: the plane in the frame rises with them.
const capabilities = [
  { place:'The foundation', title:'Strategy and direction', description:'Understand where AI can make a difference in your organisation. Develop the strategy, business case and policies to put it into practice.', topics:'AI strategy, business cases, policies and governance.' },
  { place:'The structure', title:'Tools and implementation', description:'Put AI to work in the context of your business. Develop knowledge bases, tools and workflows that support the work your people already do.', topics:'Knowledge bases, workflow development, AI implementation.' },
  { place:'The expression', title:'Learning and adoption', description:'Build competency within your organisation through learning tailored to your industry, workflows and tools. Help people understand how to use AI in their everyday work.', topics:'Tailored learning, staff development, practical adoption.' },
];
---
<Page>
  <header class="site-header wrap" id="top">
    <a class="brand" href="#top" aria-label="Vectis home"><img src="/assets/vectis-wordmark.png" width="2044" height="481" alt="Vectis"/></a>
    <nav aria-label="Main navigation"><a href="#capabilities">Capabilities</a><a href="#approach">Approach</a>{site.contactEmail && <a href="#contact">Contact</a>}</nav>
  </header>
  <main id="main">
    <div class="opening">
      <div class="wrap">
        <h1 id="hero-title" class="hero-title"><span class="line">The capability to shape</span> <span class="line">what comes next.</span></h1>
        <div class="story">
          <div class="story-copy">
            <section class="hero" aria-labelledby="hero-title">
              <p class="lede">AI consultancy for civil, structural and construction engineering firms.</p>
              <a class="primary-link" href="#capabilities">Explore our capabilities</a>
            </section>
            <section class="capabilities" id="capabilities" aria-labelledby="capability-title">
              <h2 id="capability-title" data-reveal>Expertise in the foundation.<br/>Invention in the expression.</h2>
              <ol class="levels">
                {capabilities.map((item, i) => (
                  <li class="level" data-level={i} data-place={item.place} tabindex="0" aria-labelledby={`level-${i}`}>
                    <h3 id={`level-${i}`} data-reveal>{item.title}</h3>
                    <p data-reveal style="--d:80ms">{item.description}</p>
                    <p class="level-topics" data-reveal style="--d:160ms">{item.topics}</p>
                  </li>
                ))}
              </ol>
            </section>
          </div>
          <div class="story-visual"><Structure/></div>
        </div>
      </div>
    </div>

    <section class="agency" aria-labelledby="agency-title">
      <div class="wrap agency-grid">
        <h2 id="agency-title" data-reveal>Agency at the centre.</h2>
        <p class="statement" data-reveal style="--d:90ms">Vectis helps clients gain the understanding and capability to control their future proactively.</p>
      </div>
    </section>

    <section class="approach" id="approach" aria-labelledby="approach-title">
      <div class="wrap approach-grid">
        <div class="approach-copy">
          <h2 id="approach-title" data-reveal>Building competency within your organisation.</h2>
          <p data-reveal style="--d:80ms">Developing the tools is part of the process. Helping your people use them is what brings that work into everyday practice.</p>
          <p data-reveal style="--d:160ms">Our approach brings AI implementation together with specialised learning, grounded in 18 years of experience in education.</p>
          {site.contactEmail && <a class="secondary-link" href="#contact" data-reveal style="--d:240ms">Talk to us about your team</a>}
        </div>
        <div class="context" role="img" aria-label="Learning built from your industry, your workflows and your tools, centred on your people.">
          <p data-reveal>Your industry</p>
          <p data-reveal style="--d:80ms">Your workflows</p>
          <p data-reveal style="--d:160ms">Your tools</p>
          <p class="context-people" data-reveal style="--d:260ms">Your people</p>
        </div>
      </div>
    </section>

    {site.contactEmail && (
      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div class="wrap contact-grid">
          <h2 id="contact-title" data-reveal>Talk to Vectis.</h2>
          <a class="contact-email" href={site.contactHref} data-reveal style="--d:90ms">{site.contactEmail}</a>
        </div>
      </section>
    )}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <img class="footer-mark" src="/assets/vectis-wordmark.png" width="2044" height="481" alt="Vectis" loading="lazy"/>
      <div class="footer-row">
        <p>The capability to shape what comes next.</p>
        <p>© {new Date().getFullYear()} Vectis · vectisadvisory.co.nz</p>
        <a href="#top">Back to top</a>
      </div>
    </div>
  </footer>
</Page>
