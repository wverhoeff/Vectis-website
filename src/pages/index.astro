---
import Page from '../layouts/Page.astro';
import Structure from '../components/Structure.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config';
const capabilities = [
  { title:'Strategy & direction', label:'A CLEAR WAY FORWARD', description:'Understand where AI can make a difference in your organisation. Develop the strategy, business case and policies to put it into practice.', topics:['AI strategy','Business cases','Policies & governance'] },
  { title:'Tools & implementation', label:'BUILT AROUND YOUR WORK', description:'Put AI to work in the context of your business. Develop knowledge bases, tools and workflows that support the work your people already do.', topics:['Knowledge bases','Workflow development','AI implementation'] },
  { title:'Learning & adoption', label:'BRING YOUR PEOPLE ALONG', description:'Build competency within your organisation through learning tailored to your industry, workflows and tools. Help people understand how to use AI in their everyday work.', topics:['Tailored learning','Staff development','Practical adoption'] },
];
---
<Page>
  <header class="site-header wrap" id="top">
    <a class="brand" href="#top" aria-label="Vectis home"><img src="/assets/vectis-wordmark.png" width="2044" height="481" alt="Vectis"/></a>
    <nav aria-label="Main navigation"><a href="#capabilities">Capabilities</a><a href="#approach">Our approach <span><Arrow/></span></a>{site.contactEmail && <a href="#contact">Contact</a>}</nav>
  </header>
  <main id="main">
    <div class="opening">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>AI FOR ENGINEERING FIRMS</p><h1 id="hero-title">The capability to<br/>shape what<br/><span>comes next.</span></h1><p class="hero-description">Expertise in the foundation.<br/>Invention in the expression.</p><a class="primary-link" href="#capabilities">Explore our capabilities <Arrow/></a></div>
        <Structure/>
        <div class="hero-baseline"><span class="mono">01 / WHAT COMES NEXT</span><span>Civil <span class="separator">/</span> Structural <span class="separator">/</span> Construction</span><a href="#introduction" aria-label="Scroll to introduction">↓</a></div>
      </section>
    </div>
    <section class="introduction light-section" id="introduction" aria-labelledby="intro-title"><div class="wrap intro-grid"><div><p class="eyebrow section-label">01 — THE IDEA</p><h2 id="intro-title">Agency at<br/>the centre.</h2></div><div class="intro-copy"><p>Vectis helps clients gain the understanding and capability to <em>control their future proactively.</em></p><p class="supporting-copy">AI consultancy for civil, structural and construction engineering firms.</p></div></div></section>
    <section class="capabilities light-section" id="capabilities" aria-labelledby="capability-title"><div class="wrap"><div class="section-heading"><p class="eyebrow section-label">02 — OUR CAPABILITIES</p><h2 id="capability-title">Expertise in the foundation.<br/><span>Invention in the expression.</span></h2></div><div class="capability-list">{capabilities.map((item,i) => <details open={i===0}><summary><span class="row-number">0{i+1}</span><span class="row-title">{item.title}</span><span class="row-tags">{item.label}</span><span class="expand-icon" aria-hidden="true"></span></summary><div class="capability-content"><p>{item.description}</p><div class="topic-list">{item.topics.map(t => <span>{t}</span>)}</div></div></details>)}</div></div></section>
    <section class="approach" id="approach" aria-labelledby="approach-title"><div class="wrap approach-grid"><div class="approach-copy"><p class="eyebrow">03 — OUR APPROACH</p><h2 id="approach-title">Building competency<br/><span>within your organisation.</span></h2><p>Developing the tools is part of the process. Helping your people use them is what brings that work into everyday practice.</p><p>Our approach brings AI implementation together with specialised learning, grounded in 18 years of experience in education.</p><a class="text-link" href="#capabilities">Explore how we can help <Arrow/></a></div><div class="learning-graphic" aria-label="Learning connects your industry, your workflows and your tools with your people" role="img"><div class="learning-label mono" aria-hidden="true">LEARNING IN CONTEXT <span>V / 02</span></div><div class="learning-stack" aria-hidden="true">{['Your industry','Your workflows','Your tools'].map((label,i)=><div class={`learning-layer layer-${i+1}`}><span>0{i+1}</span><strong>{label}</strong><Arrow/></div>)}<div class="learning-connector"></div><div class="people-node"><span class="status-dot"></span>Your people</div></div><div class="learning-footer mono" aria-hidden="true">UNDERSTANDING → APPLICATION → COMPETENCY</div></div></div></section>
    {site.contactEmail && <section class="contact light-section" id="contact" aria-labelledby="contact-title"><div class="wrap contact-grid"><div><p class="eyebrow section-label">04 — CONTACT</p><h2 id="contact-title">Get in touch.</h2></div><a class="contact-email" href={site.contactHref}>{site.contactEmail} <Arrow/></a></div></section>}
  </main>
  <footer class="site-footer"><div class="wrap"><div class="footer-main"><a class="brand footer-brand" href="#top" aria-label="Vectis home"><img src="/assets/vectis-wordmark.png" width="2044" height="481" alt="Vectis" loading="lazy"/></a><p>The capability to shape<br/>what comes next.</p><a class="back-top" href="#top" aria-label="Back to top">↑</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Vectis</span><span>AI FOR ENGINEERING FIRMS</span></div></div></footer>
</Page>
