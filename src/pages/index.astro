---
import Page from '../layouts/Page.astro';
import { site } from '../config';
// Read foundation first: the camera climbs the building with them.
const capabilities = [
  { place:'The foundation', title:'Strategy and direction', description:'Get clear advice on where to start with AI, which tools to use and how to use them. Develop a strategy, business case and policies around your priorities, with a focus on practical value early on.', topics:['AI strategy','Business cases','Policies and governance'] },
  { place:'The structure', title:'Tools and implementation', description:'Use AI to augment the work and workflows of your people. Build knowledge bases and tools around your business, starting where they can make a useful difference quickly and measuring the value they bring.', topics:['Knowledge bases','Workflow development','AI implementation'] },
  { place:'The expression', title:'Learning and adoption', description:'Build competency within your organisation through learning tailored to your industry, workflows and tools. Help people understand how to use AI productively in their everyday work.', topics:['Tailored learning','Staff development','Practical adoption'] },
];
---
<Page>
  <canvas id="scene" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <header class="site-header">
    <div class="nav-pill">
      <a class="brand" href="#top" aria-label="Vectis home"><img src="/assets/vectis-wordmark.png" width="2044" height="481" alt="Vectis"/></a>
      <nav aria-label="Main navigation"><a href="#capabilities">Capabilities</a><a href="#approach">Approach</a></nav>
      <a class="nav-cta" href="#contact">Inquire</a>
    </div>
  </header>
  <main id="main">
    <div class="track" id="top">
      <section class="hero stage" aria-labelledby="hero-title">
        <div class="wrap stage-inner">
          <p class="kicker" data-reveal>AI consultancy for the construction sector</p>
          <h1 id="hero-title" data-reveal style="--d:80ms">The capability to shape <span class="glow">what comes next.</span></h1>
          <p class="lede" data-reveal style="--d:160ms">Vectis helps construction sector companies gain the understanding and capability to control their future proactively.</p>
          <div class="actions" data-reveal style="--d:240ms">
            <a class="btn btn-ghost" href="#approach">Our approach</a>
          </div>
        </div>
        <a class="scroll-cue" href="#capabilities" aria-label="Scroll to capabilities"><span></span></a>
      </section>
      <div id="capabilities" aria-label="Capabilities">
        {capabilities.map((item) => (
          <section class="stage capability" aria-labelledby={`cap-${item.place}`}>
            <div class="wrap stage-inner">
              <article class="panel" data-reveal>
                <p class="panel-place">{item.place}</p>
                <h2 id={`cap-${item.place}`}>{item.title}</h2>
                <p>{item.description}</p>
                <ul class="chips">{item.topics.map(t => <li>{t}</li>)}</ul>
              </article>
            </div>
          </section>
        ))}
      </div>
    </div>

    <section class="agency" aria-labelledby="agency-title">
      <div class="wrap">
        <h2 id="agency-title" data-reveal>People at <span class="glow">the centre.</span></h2>
        <p class="statement" data-reveal style="--d:90ms">Expertise in the foundation. Invention in the expression.</p>
        <p class="agency-copy" data-reveal style="--d:160ms">AI supports your people's work. Your people stay in control of the decisions.</p>
      </div>
    </section>

    <section class="approach" id="approach" aria-labelledby="approach-title">
      <div class="wrap approach-grid">
        <div>
          <h2 id="approach-title" data-reveal>Building competency within your organisation.</h2>
          <p data-reveal style="--d:80ms">Developing the tools is part of the process. Helping your people use them is what brings that work into everyday practice.</p>
          <p data-reveal style="--d:160ms">Our approach brings AI implementation together with specialised learning, backed by over 15 years of experience in education.</p>
        </div>
        <div class="context" role="img" aria-label="Learning built from your industry, your workflows and your tools, centred on your people.">
          <span data-reveal>Your industry</span>
          <span data-reveal style="--d:80ms">Your workflows</span>
          <span data-reveal style="--d:160ms">Your tools</span>
          <strong data-reveal style="--d:260ms">Your people</strong>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap contact-grid">
        <div class="contact-intro">
          <h2 id="contact-title" data-reveal>Let's talk about <span class="glow">what comes next.</span></h2>
          <p data-reveal style="--d:80ms">Tell us a little about your firm and what you're looking to do with AI. We'll get back to you.</p>
        </div>
        <form class="contact-form" action="/api/contact" method="post" data-reveal style="--d:120ms">
          <div class="field-row">
            <div class="field">
              <label for="f-name">Name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120"/>
              <p class="field-error" id="e-name" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="f-email">Email</label>
              <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200"/>
              <p class="field-error" id="e-email" aria-live="polite"></p>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-company">Company <span class="optional">(optional)</span></label>
              <input id="f-company" name="company" type="text" autocomplete="organization" maxlength="160"/>
              <p class="field-error" id="e-company" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="f-phone">Phone <span class="optional">(optional)</span></label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40"/>
              <p class="field-error" id="e-phone" aria-live="polite"></p>
            </div>
          </div>
          <div class="field">
            <label for="f-topic">What are you interested in? <span class="optional">(optional)</span></label>
            <select id="f-topic" name="topic">
              <option value="">Choose one</option>
              <option>Strategy and direction</option>
              <option>Tools and implementation</option>
              <option>Learning and adoption</option>
              <option>Something else</option>
            </select>
            <p class="field-error" id="e-topic" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="f-message">How can we help?</label>
            <textarea id="f-message" name="message" rows="5" required minlength="10" maxlength="5000"></textarea>
            <p class="field-error" id="e-message" aria-live="polite"></p>
          </div>
          <div class="hp" aria-hidden="true"><label for="f-website">Website</label><input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off"/></div>
          {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-theme="dark" data-size="flexible"></div>}
          <div class="form-foot">
            <button class="btn btn-primary" type="submit">Send enquiry</button>
            <p class="privacy">We only use your details to reply to your enquiry.</p>
          </div>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <img class="footer-mark" src="/assets/vectis-wordmark.png" width="2044" height="481" alt="Vectis" loading="lazy"/>
      <div class="footer-row">
        <p>The capability to shape what comes next.</p>
        <p>© {new Date().getFullYear()} Vectis · vectisadvisory.co.nz</p>
        <a href="#top">Back to top</a>
      </div>
    </div>
  </footer>
  <script src="../scripts/scene.js"></script>
  <script src="../scripts/contact.js"></script>
  {site.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Page>
